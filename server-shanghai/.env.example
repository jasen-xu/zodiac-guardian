# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_NAME=yidao
DB_USER=yidao
DB_PASSWORD=your_database_password_here

# 服务端口
PORT=3001

# Session 密钥（请使用随机字符串）
SESSION_SECRET=your_random_secret_key_here

# 管理员密码（用于登录管理后台）
ADMIN_PASSWORD=your_admin_password

# SCF 调用此 API 的密钥（需与 SCF 环境变量 SHANGHAI_API_KEY 一致）
API_KEY=your_api_key_here
