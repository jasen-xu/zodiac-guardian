# ============================================
# 易道管理后台 - 环境变量配置
# 复制为 .env 并填入实际值
# ============================================

# --- 服务器 ---
PORT=3001

# --- PostgreSQL 数据库 ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=yidao
DB_USER=yidao
DB_PASSWORD=your_db_password

# --- 管理后台密码 ---
ADMIN_PASSWORD=your_admin_password

# --- API 密钥（SCF 云函数调用用） ---
API_KEY=your_api_key_here

# --- Session 密钥 ---
SESSION_SECRET=your_session_secret_here

# --- JWT 密钥（用户认证） ---
JWT_SECRET=your_jwt_secret_here_change_this

# --- 腾讯云短信服务 ---
# 腾讯云 API 密钥（https://console.cloud.tencent.com/cam/capi）
SMS_SECRET_ID=your_tencent_secret_id
SMS_SECRET_KEY=your_tencent_secret_key

# 短信应用 ID（https://console.cloud.tencent.com/smsv2/appmgr）
SMS_APP_ID=your_sms_app_id

# 短信签名（需审核通过）
SMS_SIGN=易道

# 短信模板 ID（验证码模板，需审核通过）
# 模板内容示例：您的验证码为{1}，{2}分钟内有效。
SMS_TEMPLATE_ID=your_sms_template_id
